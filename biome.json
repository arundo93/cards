{
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "*.json", "*.ts", "!package-lock.json"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
