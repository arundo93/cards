# Dependencies and package-manager caches (keep package-lock.json).
node_modules/
.npm/

# Vite / TypeScript build output and caches.
/dist/
/dist-ssr/
/dev-dist/
.vite/
.vite-temp/
.cache/
*.tsbuildinfo
*.local

# Tests and generated reports, including the PWA build report.
/coverage/
/.reports/
/playwright-report/
/playwright/.cache/
/test-results/

# Local environment values; sanitized templates belong in the repository.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
/
# Docs
.docs/

# Logs and temporary files.
*.log
/tmp/
/temp/
*.tmp
*.swp
*.swo
*~

# Editor-local state; keep useful shared VS Code settings.
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace

# Operating-system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
